# انسخ الملف إلى .env.production ولا ترفع الملف الحقيقي إلى Git.
API_PORT=3000
DB_HOST_PORT=5433
DB_USER=hesba
DB_NAME=hesba
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_IN=30d
JWT_ISSUER=hesba-api
JWT_AUDIENCE=hesba-desktop
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# اختياري: كود قوي من 32 حرفًا أو أكثر لإنشاء مدير استعادة من شاشة الدخول.
ADMIN_RECOVERY_KEY=
# اكتب الدومينات المسموح لها مفصولة بفاصلة، واتركها فارغة لتطبيق سطح المكتب فقط.
CORS_ORIGINS=
FIREBASE_PROJECT_ID=hespa-system
# Path inside the API container (compose mounts ./backend/secrets → /app/secrets)
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-adminsdk.json
